BOT_TOKEN=123456789:replace_with_your_bot_token
SUPPORT_CHAT_ID=-1001234567890
DB_FILE=data/bot.sqlite3
LANGUAGE=en
LOCALES_DIR=locales
BOT_MODE=polling

# Optional proxy. Examples:
# PROXY_URL=http://127.0.0.1:7890
# PROXY_URL=socks5://127.0.0.1:1080
PROXY_URL=
GET_UPDATES_PROXY_URL=

# Webhook mode, used only when BOT_MODE=webhook
WEBHOOK_URL=https://example.com
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=7024
WEBHOOK_PATH=telegram-webhook
WEBHOOK_SECRET_TOKEN=replace_with_a_random_secret
